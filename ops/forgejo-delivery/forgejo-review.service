[Unit]
Description=Host-isolated Forgejo pull-request reviewer
After=network-online.target
ConditionUser=admin-papa

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/admin-papa/governance/sprucegoose/ops/forgejo-delivery/controller.py review-all --policy /home/admin-papa/.config/forgejo-delivery/policy.json --token-file /home/admin-papa/.config/forgejo-delivery/reviewer.token
Environment=HOME=/home/admin-papa
Environment=PATH=/home/admin-papa/.local/bin:/home/admin-papa/.npm-global/bin:/usr/local/bin:/usr/bin
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/admin-papa/.config/forgejo-delivery/reviewer.token
InaccessiblePaths=/home/admin-papa/.config/forgejo-delivery/merger.token
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
