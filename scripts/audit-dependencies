#!/usr/bin/env bash
# Fail on any dependency advisory that has not been explicitly accepted.
#
# `mix hex.audit` exits non-zero for every advisory, fixable or not. Run bare in
# CI under `set -e` it made the pipeline permanently red the moment an advisory
# landed on a transitive dependency with no fixed release — and a gate that is
# always red is a gate nobody reads. It sat at line 2, so every check after it
# was unreachable.
#
# So: accepted advisories are listed, with an owner and an expiry, and
# everything else fails. An expired entry fails too.
set -euo pipefail

repo=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "ERROR: not a git worktree" >&2; exit 2; }
cd "$repo"
allowlist=${HEX_AUDIT_ALLOWLIST:-$repo/.hex-audit-allowlist}
today=$(date -u +%Y-%m-%d)

audit=$(mix hex.audit 2>&1) || true

# "  package 1.2.3 - ADVISORY-ID (SEVERITY)"
found=$(printf '%s\n' "$audit" |
  sed -nE 's/^[[:space:]]+([a-z_0-9]+) ([^ ]+) - ([^ ]+) \((.+)\)$/\3 \1 \2 \4/p' | sort -u)

if [[ -z $found ]]; then
  echo "dependency-audit=PASS (no advisories)"
  exit 0
fi

blocking=""
accepted=""

while read -r id package version severity; do
  [[ -z $id ]] && continue
  entry=$(grep -E "^${id}[[:space:]]" "$allowlist" 2>/dev/null || true)

  if [[ -z $entry ]]; then
    blocking+=$'\n'"  $id  $package $version ($severity)  — not accepted"
    continue
  fi

  expires=$(awk '{print $2}' <<<"$entry")
  owner=$(awk '{print $3}' <<<"$entry")

  if [[ ! $expires =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    blocking+=$'\n'"  $id  $package $version ($severity)  — allowlist entry has no valid expiry"
  elif [[ $today > $expires ]]; then
    blocking+=$'\n'"  $id  $package $version ($severity)  — acceptance expired $expires ($owner)"
  else
    accepted+=$'\n'"  $id  $package $version ($severity)  — accepted until $expires ($owner)"
  fi
done <<<"$found"

[[ -n $accepted ]] && printf 'Accepted advisories:%s\n' "$accepted"

if [[ -n $blocking ]]; then
  printf 'Blocking advisories:%s\n\n' "$blocking" >&2
  echo "Upgrade the dependency, or add the advisory to $allowlist with an owner" >&2
  echo "and a review date if it genuinely cannot be reached from this system." >&2
  exit 1
fi

echo "dependency-audit=PASS"
