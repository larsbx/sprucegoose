#!/usr/bin/env bash
set -euo pipefail
umask 077

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 2; }
mode=${1:---release}
[[ $# -le 1 && ( $mode == --check || $mode == --release ) ]] ||
  fail "usage: scripts/ci-governed-release [--check|--release]"
repo=$(git rev-parse --show-toplevel 2>/dev/null) || fail "not a git worktree"
cd "$repo"
git diff-index --quiet HEAD -- || fail "dirty tracked workspace refused"
[[ -z $(git ls-files --others --exclude-standard) ]] || fail "dirty untracked workspace refused"

evidence=${CI_EVIDENCE_DIR:-$repo/ci-evidence}
[[ $evidence = /* ]] || fail "CI evidence path must be absolute"
case "$evidence" in "$repo"|"$repo"/*) ;; *) fail "CI evidence must be reviewer-resolvable inside the workspace";; esac
[[ ! -e $evidence && ! -L $evidence ]] || fail "CI evidence path must not exist"
archive_root=not-used-in-check-mode
if [[ $mode == --release ]]; then
  archive_root=${CI_RELEASE_OUTPUT_ROOT:-$(dirname "$repo")/sprucegoose-ci-releases}
  [[ $archive_root = /* ]] || fail "CI release output path must be absolute"
  case "$archive_root" in "$repo"|"$repo"/*) fail "release output must be outside the workspace";; esac
  [[ ! -e $archive_root && ! -L $archive_root ]] || fail "CI release output path must not exist"
fi
mkdir -m 0700 -- "$evidence"

crash="$evidence/erl-crash-${CI_PIPELINE_NUMBER:-local}-$$.dump"
export ERL_CRASH_DUMP="$crash" ERL_CRASH_DUMP_SECONDS=0

snapshot() {
  find . -path './.git' -prune -o -path './_build' -prune -o -path './deps' -prune \
    -o -path './ci-evidence' -prune -o -type f -print0 |
    LC_ALL=C sort -z | xargs -0r sha256sum
}
verify_workspace() {
  snapshot >"$evidence/workspace-after.sha256"
  cmp "$evidence/workspace-before.sha256" "$evidence/workspace-after.sha256" ||
    fail "undeclared candidate workspace mutation detected"
  if [[ -e $crash ]]; then
    chmod 0600 "$crash"
    sha256sum "$crash" >"$evidence/erl-crash.sha256"
    fail "runtime crash dump produced; preserved in CI evidence"
  fi
}
snapshot >"$evidence/workspace-before.sha256"
cat >"$evidence/declared-paths.txt" <<EOF
candidate-read-only-exclusions:
_build
deps
ci-evidence
external-release-output:
$archive_root
runtime-crash-path:
$crash
EOF

mix deps.get
scripts/audit-dependencies
mix format --check-formatted
mix compile --warnings-as-errors

ci_db_suffix=${CI_PIPELINE_NUMBER:-local}
[[ $ci_db_suffix =~ ^([0-9]+|local)$ ]] || fail "invalid CI pipeline number for test database"
export SPRUCE_GOOSE_TEST_DATABASE="spruce_goose_ci_${ci_db_suffix}"
# Credentials for the isolated test database, when the server requires them.
# Unset means trust authentication, which is the local default. A runner whose
# PostgreSQL wants a password sets these; the alternative was skipping the test
# gate entirely, which is how a release candidate reaches a deployment host
# with its suite unexecuted.
: "${SPRUCE_GOOSE_TEST_DATABASE_USERNAME:=}"
: "${SPRUCE_GOOSE_TEST_DATABASE_PASSWORD:=}"
: "${SPRUCE_GOOSE_TEST_DATABASE_HOSTNAME:=}"
: "${SPRUCE_GOOSE_TEST_DATABASE_PORT:=}"
for var in SPRUCE_GOOSE_TEST_DATABASE_USERNAME SPRUCE_GOOSE_TEST_DATABASE_PASSWORD \
           SPRUCE_GOOSE_TEST_DATABASE_HOSTNAME SPRUCE_GOOSE_TEST_DATABASE_PORT; do
  if [[ -n ${!var} ]]; then
    export "$var"
  else
    unset "$var"
  fi
done
cleanup_test_database() {
  MIX_ENV=test mix ecto.drop --force --quiet >/dev/null 2>&1 || true
}
trap cleanup_test_database EXIT
MIX_ENV=test mix ecto.create --quiet
MIX_ENV=test mix ash.migrate
mix test

# The :separate_sessions group is excluded by test_helper.exs because it needs
# genuinely separate database sessions rather than the sandbox. It covers
# genesis races, contiguous certified append positions, ledger recovery, and
# runtime-shadow concurrency — the claims the audit trail leans on hardest — and
# it had never run in CI, which is how a stale genesis assertion survived. Not
# optional: a concurrency regression here is a correctness regression.
mix test --only separate_sessions --seed 0 --max-cases 1

MIX_ENV=test mix ecto.drop --force --quiet
trap - EXIT

if [[ $mode == --check ]]; then
  verify_workspace
  printf 'ci-check=PASS\nevidence=%s\n' "$evidence"
  exit 0
fi

commit=$(git rev-parse HEAD)
tree=$(git rev-parse HEAD^{tree})
epoch=$(git show -s --format=%ct HEAD)
build_time=$(date -u -d "@$epoch" +%Y-%m-%dT%H:%M:%SZ)
export SOURCE_DATE_EPOCH="$epoch"
export SPRUCE_GOOSE_BUILDER="${SPRUCE_GOOSE_BUILDER:-woodpecker-local-backend}"
[[ ${SPRUCE_GOOSE_TASK:-} =~ ^tsk-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$ ]] ||
  fail "SPRUCE_GOOSE_TASK must identify the governing task for this build"
export SPRUCE_GOOSE_TASK
export SPRUCE_GOOSE_TRANSACTION="${SPRUCE_GOOSE_TRANSACTION:-woodpecker-${CI_PIPELINE_NUMBER:-local}-${commit}}"
export SPRUCE_GOOSE_BUILD_TIME_UTC="$build_time"
export SPRUCE_GOOSE_OUTPUT_DIR="$archive_root"
scripts/build-governed-release >"$evidence/build.txt"

archive=$(find "$archive_root" -maxdepth 1 -type f -name '*.tar.xz' -print -quit)
[[ -n $archive ]] || fail "governed release archive was not produced"
receipt="$archive.receipt.json"
[[ -f $receipt ]] || fail "governed release receipt was not produced"

scripts/inspect-governed-release "$archive" >"$evidence/provenance.json"
scripts/validate-governed-release "$archive" --receipt "$receipt" \
  --expected-commit "$commit" --expected-tree "$tree" --artifact-only \
  >"$evidence/validation.txt"

verify_workspace

sha256sum "$archive" "$receipt" "$evidence/provenance.json" \
  "$evidence/validation.txt" >"$evidence/evidence.sha256"
printf 'ci-governed-release=PASS\nevidence=%s\narchive=%s\n' "$evidence" "$archive"
